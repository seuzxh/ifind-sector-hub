  "cards": [
    {
      "dot": "rose",
      "title": "安全语义",
      "items": [
        "HTTP 401 才触发刷新路径，其余异常走指数退避重试",
        "刷新成功后仅重试本轮请求一次，防止刷新失败死循环",
        "REFRESH_TOKEN 轮换后自动持久化，旧 refresh_token 不再复用"
      ]
    },
    {
      "dot": "cyan",
      "title": "进程内双检",
      "items": [
        "threading.Lock 内先比对调用方持有的 stale token",
        "他线程已刷新则直接复用新 token，不再打刷新接口",
        "TokenStore 默认内存态，重启进程重新引导"
      ]
    },
    {
      "dot": "orange",
      "title": "跨进程共享",
      "items": [
        "FileTokenStore 在 flock 文件锁内做跨进程双检",
        "同机多消费方共用账号时，刷新结果与轮换自动共享",
        "取代旧实现正则改写 config_local.py 的做法"
      ]
    }
  ]
