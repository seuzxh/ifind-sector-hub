  "cards": [
    {
      "dot": "cyan",
      "title": "数据源与凭据",
      "items": [
        "IFindClient 覆盖接口1-6、实时行情与 smart_pick（get_all_ths_boards 动态枚举板块全集）",
        "HTTP 401 经 TokenStore 双检刷新后仅重试本轮一次，防止死循环",
        "FileTokenStore 以 JSON + flock 落盘，跨进程共享刷新与 REFRESH_TOKEN 轮换"
      ]
    },
    {
      "dot": "emerald",
      "title": "三表存储",
      "items": [
        "ths_concept_dict / concept_members / stock_concept_map 三表",
        "读方法不传日期取 MAX(date) 最新快照，历史不清理",
        "INSERT OR REPLACE 幂等写入，replace_concept_dict 级联清理 + 同事务迁移钩子"
      ]
    },
    {
      "dot": "violet",
      "title": "同步编排",
      "items": [
        "成分股线程池并发（默认 8），失败概念不中断整体",
        "全集补全：扫全市场股票反向发现新概念码",
        "观察池刷新：接口5 刷字典 + 接口2 刷成分股"
      ]
    },
    {
      "dot": "amber",
      "title": "复用边界",
      "items": [
        "自 monitor（ifind-sector-attribution）原语义抽离",
        "核心依赖仅 requests，存储走标准库 sqlite3",
        "FastAPI 服务层为可选 extra，本期只交付不部署"
      ]
    }
  ]
